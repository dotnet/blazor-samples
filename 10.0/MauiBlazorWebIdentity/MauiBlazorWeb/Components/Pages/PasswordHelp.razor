@page "/password-help"
@inject AccountClient AccountClient

<PageTitle>Password help</PageTitle>
<h1>Password help</h1>
<div class="row"><div class="col-lg-6">
    <EditForm Model="reset" OnValidSubmit="ResetAsync">
        <DataAnnotationsValidator /><ValidationSummary class="text-danger" />
        @if (message is not null) { <div class="alert @alertClass" role="alert">@message</div> }
        <div class="form-floating mb-3"><InputText @bind-Value="reset.Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><label>Email</label></div>
        <button type="button" class="btn btn-outline-primary mb-3" disabled="@busy" @onclick="ForgotAsync">Send reset link</button>
        <p class="small text-muted">Paste the reset code from the link or development notification to choose a new password.</p>
        <div class="form-floating mb-3"><InputText @bind-Value="reset.ResetCode" class="form-control" autocomplete="off" placeholder="Reset code" /><label>Reset code</label></div>
        <div class="form-floating mb-3"><InputText @bind-Value="reset.NewPassword" type="password" class="form-control" autocomplete="new-password" placeholder="New password" /><label>New password</label></div>
        <button class="btn btn-primary" disabled="@busy">Reset password</button>
    </EditForm>
</div></div>

@code {
    private readonly ResetPasswordModel reset = new();
    private bool busy; private string? message; private string alertClass = "alert-info";
    private async Task ForgotAsync() { busy = true; var result = await AccountClient.ForgotPasswordAsync(reset.Email); Set(result, "If an account exists, a reset link has been sent."); busy = false; }
    private async Task ResetAsync() { busy = true; var result = await AccountClient.ResetPasswordAsync(reset); Set(result, "Your password has been reset. You can now sign in."); busy = false; }
    private void Set(ApiResult result, string success) { alertClass = result.Succeeded ? "alert-success" : "alert-danger"; message = result.Succeeded ? success : result.Error; }
}
