@page "/register"
@inject AccountClient AccountClient

<PageTitle>Register</PageTitle>
<h1>Create an account</h1>
<div class="row"><div class="col-lg-6"><EditForm Model="model" OnValidSubmit="RegisterAsync">
    <DataAnnotationsValidator /><ValidationSummary class="text-danger" />
    @if (message is not null) { <div class="alert @alertClass" role="alert">@message</div> }
    <div class="form-floating mb-3"><InputText @bind-Value="model.Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><label>Email</label></div>
    <div class="form-floating mb-3"><InputText @bind-Value="model.Password" type="password" class="form-control" autocomplete="new-password" placeholder="Password" /><label>Password</label></div>
    <button class="btn btn-primary" disabled="@busy">Create account</button>
</EditForm></div></div>
@if (message is not null && alertClass == "alert-success")
{
    <p class="mt-3">During development, <a href="@HttpClientHelper.DevelopmentNotificationsUrl">view sent confirmation notifications</a>.</p>
}

@code {
    private readonly RegisterModel model = new();
    private bool busy;
    private string? message;
    private string alertClass = "alert-info";
    private async Task RegisterAsync()
    {
        busy = true;
        var result = await AccountClient.RegisterAsync(model);
        busy = false;
        alertClass = result.Succeeded ? "alert-success" : "alert-danger";
        message = result.Succeeded ? "Account created. Check your email for the confirmation link." : result.Error;
    }
}
