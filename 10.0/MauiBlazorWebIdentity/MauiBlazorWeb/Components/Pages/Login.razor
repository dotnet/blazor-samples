@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject MauiSignInManager SignInManager
@inject ILogger<Login> Logger

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>
<div class="row">
    <div class="col-lg-6">
        <section>
            <EditForm Model="LoginModel" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2>Use a local account to log in.</h2>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                @if (errorMessage is not null)
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }
                <div class="form-floating mb-3">
                    <InputText @bind-Value="LoginModel.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.Email" class="form-label">Email</label>
                    <ValidationMessage For="() => LoginModel.Email" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="LoginModel.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label for="Input.Password" class="form-label">Password</label>
                    <ValidationMessage For="() => LoginModel.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="LoginModel.RememberMe" class="darker-border-checkbox form-check-input" />
                        Remember me
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary" disabled="@isSubmitting">Log in</button>
                </div>
                <p class="mt-3"><NavLink href="register">Register as a new user</NavLink></p>
            </EditForm>
        </section>
    </div>
</div>

@code {

    private InputModel LoginModel { get; set; } = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task LoginUser()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var result = await SignInManager.PasswordSignInAsync(
                LoginModel.Email, LoginModel.Password, isPersistent: LoginModel.RememberMe);

            if (!result.Succeeded)
            {
                errorMessage = result.IsLockedOut ? "This account is locked out. Please try again later."
                    : result.IsNotAllowed ? "Sign-in is not allowed. Check the account's confirmation status."
                    : result.RequiresTwoFactor ? "Two-factor authentication is required. This sample's native login doesn't support it."
                    : "Invalid email or password. Please try again.";
                return;
            }

            LoginModel.Password = "";
            Navigation.NavigateTo("");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "The Identity sign-in request failed.");
            errorMessage = ex.StatusCode is null
                ? "Unable to contact the server. Please try again."
                : "The server could not complete sign-in. Please try again.";
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogWarning(ex, "The Identity sign-in request timed out.");
            errorMessage = "The server took too long to respond. Please try again.";
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "The Identity sign-in response was invalid.");
            errorMessage = "The server returned an invalid sign-in response. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
